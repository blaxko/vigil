# Solana / Anchor
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com
ANCHOR_WALLET=~/.config/solana/id.json
KEEPER_KEYPAIR_PATH=~/.config/solana/keeper.json

# Server-only: devnet test-token faucet ("Get Test AAPLx" button). Mint
# authority for AAPLx, never exposed to the client. Provide EITHER a
# keypair file path OR a raw secret-key JSON array -- never commit the
# real value.
MINT_AUTHORITY_KEYPAIR_PATH=~/.config/solana/id.json
MINT_AUTHORITY_SECRET_KEY=

# Pyth Hermes (pull-oracle price update fetch)
PYTH_HERMES_ENDPOINT=https://hermes.pyth.network
AAPLX_PYTH_PRICE_FEED_ID=

# DEX reference (AAPLx/USDC pool)
AAPLX_USDC_RAYDIUM_POOL=CKwJZwm7oj3nu4653N1EpDrqXbXAYXoPFiPeEnLouF8y
GECKOTERMINAL_API_BASE=https://api.geckoterminal.com/api/v2
DEXSCREENER_API_BASE=https://api.dexscreener.com

# Pyth Benchmarks (historical replay data)
PYTH_BENCHMARKS_API_BASE=https://benchmarks.pyth.network

# Program IDs (filled in after devnet deploy)
REGIME_ORACLE_PROGRAM_ID=
LENDING_MARKET_PROGRAM_ID=
AAPLX_MINT=
USDC_MINT=
